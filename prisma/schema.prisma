datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  OWNER
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentType {
  DP
  FULL
}

enum PaymentPhase {
  DP
  FULL
  PELUNASAN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PromoType {
  PERCENTAGE
  FIXED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String
  passwordHash String?
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings     Booking[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Package {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String
  price           Decimal   @db.Decimal(12, 2)
  durationMinutes Int       @default(60)
  maxPeople       Int       @default(4)
  photoCount      Int       @default(10)
  features        String    // JSON string array of features
  imageUrl        String?
  active          Boolean   @default(true)
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]

  @@map("packages")
}

model AddOn {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Decimal        @db.Decimal(12, 2)
  extraMinutes    Int            @default(0)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookingAddOns   BookingAddOn[]

  @@map("addons")
}

model Room {
  id             String          @id @default(cuid())
  name           String
  description    String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  bookings       Booking[]
  operatingHours OperatingHour[]
  blockedSlots   BlockedSlot[]

  @@map("rooms")
}

model OperatingHour {
  id            String   @id @default(cuid())
  dayOfWeek     Int      // 0=Minggu, 1=Senin, ..., 6=Sabtu
  openTime      String   // "09:00"
  closeTime     String   // "21:00"
  isActive      Boolean  @default(true)
  bufferMinutes Int      @default(15) // buffer antar sesi
  roomId        String?
  room          Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([dayOfWeek, roomId])
  @@map("operating_hours")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  roomId    String?
  room      Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  reason    String
  createdBy String?
  createdAt DateTime @default(now())

  @@map("blocked_slots")
}

model Booking {
  id              String         @id @default(cuid())
  bookingCode     String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName       String
  guestEmail      String
  guestPhone      String
  packageId       String
  package         Package        @relation(fields: [packageId], references: [id])
  roomId          String?
  room            Room?          @relation(fields: [roomId], references: [id])
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus  @default(PENDING_PAYMENT)
  paymentType     PaymentType    @default(DP)
  subtotal        Decimal        @db.Decimal(12, 2)
  discountAmount  Decimal        @default(0) @db.Decimal(12, 2)
  promoCode       String?
  totalPrice      Decimal        @db.Decimal(12, 2)
  dpAmount        Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?
  expiresAt       DateTime       // slot hold expires after 15 minutes
  rescheduleCount Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookingAddOns   BookingAddOn[]
  payments        Payment[]
  review          Review?

  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model BookingAddOn {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn    @relation(fields: [addOnId], references: [id])
  qty         Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  @@map("booking_addons")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type          PaymentPhase  // DP, FULL, PELUNASAN
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  method        String?       // QRIS, VA_BCA, VA_MANDIRI, EWALLET, CASH, TRANSFER
  provider      String        @default("SIMULATOR") // SIMULATOR, MIDTRANS, MANUAL
  providerRef   String?
  proofUrl      String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

model Promo {
  id            String     @id @default(cuid())
  code          String     @unique
  discountType  PromoType  @default(PERCENTAGE)
  discountValue Decimal    @db.Decimal(12, 2)
  minSpend      Decimal    @default(0) @db.Decimal(12, 2)
  maxDiscount   Decimal?   @db.Decimal(12, 2)
  quota         Int        @default(100)
  usedCount     Int        @default(0)
  validUntil    DateTime
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("promos")
}

model Review {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName String
  rating       Int      @default(5)
  comment      String
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("reviews")
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  category    String   // Prewedding, Graduation, Family, Portrait, Product
  imageUrl    String
  description String?
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

model StudioSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("studio_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

